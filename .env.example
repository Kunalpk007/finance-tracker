# Copy this file to .env.local and fill in your own Supabase project's values.
# Both are safe to expose to the client — Row Level Security (see
# supabase/migrations/0004_rls.sql) is the actual security boundary, not
# secrecy of these values. See SETUP.md for where to find them.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
